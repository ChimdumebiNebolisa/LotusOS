[Desktop Entry]
Type=Application
Name=LotusOS Live Session Keepawake
Comment=Disable live-session screen locking, blanking, and DPMS during verification
Exec=/bin/sh /usr/local/bin/lotus-live-session-keepawake
Icon=preferences-desktop-display
Terminal=false
OnlyShowIn=KDE;
X-GNOME-Autostart-enabled=true
X-KDE-autostart-phase=1
