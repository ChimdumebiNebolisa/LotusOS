#!/bin/sh
set -eu

log_file=/tmp/lotus-shell-autostart.log
binary=/opt/lotus-shell/lotus-shell

exec >>"$log_file" 2>&1

echo "=== lotus-shell autostart $(date -Is 2>/dev/null || date) ==="
id || true
pwd || true

echo "--- selected environment ---"
for var in DISPLAY WAYLAND_DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP DESKTOP_SESSION XAUTHORITY XDG_RUNTIME_DIR; do
  eval "printf '%s=%s\n' \"$var\" \"\${$var-}\""
done

echo "--- environment ---"
env | sort || true

echo "--- /opt/lotus-shell ---"
ls -l /opt/lotus-shell || true

if [ ! -e "$binary" ]; then
  echo "ERROR: missing $binary"
  exit 1
fi

if [ ! -x "$binary" ]; then
  echo "ERROR: not executable $binary"
  ls -l "$binary" || true
  exit 1
fi

if command -v ldd >/dev/null 2>&1; then
  echo "--- ldd $binary ---"
  ldd "$binary" || true
fi

echo "--- launching lotus-shell ---"
exec "$binary"
