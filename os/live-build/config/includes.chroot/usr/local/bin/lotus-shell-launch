#!/bin/sh
set -eu

log_file=/tmp/lotus-shell-autostart.log
binary=/opt/lotus-shell/lotus-shell
launch_wait_seconds=10
early_exit_seconds=5

exec >>"$log_file" 2>&1

timestamp() {
  date -Is 2>/dev/null || date
}

log() {
  printf '[%s] %s\n' "$(timestamp)" "$*"
}

show_failure_dialog() {
  message=$1

  log "showing fallback dialog: $message"

  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "Lotus Shell Startup Failed" --error "$message" && return 0
  fi

  if command -v xmessage >/dev/null 2>&1; then
    xmessage -center "$message" && return 0
  fi

  log "no graphical dialog helper available"
}

dump_selected_environment() {
  log "--- selected environment ---"
  for var in DISPLAY WAYLAND_DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP DESKTOP_SESSION XAUTHORITY XDG_RUNTIME_DIR KDE_FULL_SESSION; do
    eval "printf '%s=%s\n' \"$var\" \"\${$var-}\""
  done
}

wait_for_graphical_session() {
  count=0
  while [ "$count" -lt "$launch_wait_seconds" ]; do
    if [ -n "${DISPLAY-}" ] || [ -n "${WAYLAND_DISPLAY-}" ]; then
      log "graphical session variables detected after ${count}s"
      return 0
    fi

    count=$((count + 1))
    log "waiting for graphical session variables (${count}/${launch_wait_seconds})"
    sleep 1
  done

  log "graphical session variables were still not set after ${launch_wait_seconds}s"
}

fail_launch() {
  reason=$1
  log "FAILURE: $reason"
  show_failure_dialog "Lotus Shell could not start.\n\n$reason\n\nSee: $log_file"
  exit 0
}

log "=== lotus-shell autostart start ==="
id || true
pwd || true
dump_selected_environment
wait_for_graphical_session
dump_selected_environment

log "--- environment ---"
env | sort || true

log "--- /opt/lotus-shell ---"
ls -l /opt/lotus-shell || true

if [ ! -e "$binary" ]; then
  fail_launch "Missing binary: $binary"
fi

if [ ! -x "$binary" ]; then
  log "binary is not executable"
  ls -l "$binary" || true
  fail_launch "Binary is not executable: $binary"
fi

if command -v ldd >/dev/null 2>&1; then
  log "--- ldd $binary ---"
  ldd "$binary" || true
fi

launch_started="$(date +%s 2>/dev/null || echo 0)"
log "--- launching lotus-shell ---"
set +e
"$binary"
status=$?
set -e
launch_finished="$(date +%s 2>/dev/null || echo "$launch_started")"

if [ "$launch_finished" -ge "$launch_started" ] 2>/dev/null; then
  duration=$((launch_finished - launch_started))
else
  duration=0
fi

log "lotus-shell exit status=$status duration=${duration}s"

if [ "$status" -ne 0 ]; then
  fail_launch "Lotus Shell exited with status $status after ${duration}s."
fi

if [ "$duration" -lt "$early_exit_seconds" ]; then
  fail_launch "Lotus Shell exited too early after ${duration}s."
fi

log "lotus-shell exited cleanly after ${duration}s"
