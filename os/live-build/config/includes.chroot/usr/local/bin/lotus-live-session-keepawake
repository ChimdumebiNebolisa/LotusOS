#!/bin/sh
set -eu

log_file=/tmp/lotus-live-session-keepawake.log

exec >>"$log_file" 2>&1

timestamp() {
  date -Is 2>/dev/null || date
}

log() {
  printf '[%s] %s\n' "$(timestamp)" "$*"
}

log "=== lotus live session keepawake start ==="
log "DISPLAY=${DISPLAY-}"
log "XDG_SESSION_TYPE=${XDG_SESSION_TYPE-}"

if ! command -v xset >/dev/null 2>&1; then
  log "xset not available"
  exit 0
fi

if [ -z "${DISPLAY-}" ]; then
  log "DISPLAY is not set"
  exit 0
fi

run_xset() {
  log "running: xset $*"
  if xset "$@"; then
    log "success: xset $*"
    return 0
  fi

  log "failed: xset $*"
  return 0
}

run_xset s off
run_xset -dpms
run_xset s noblank

log "=== lotus live session keepawake end ==="
