{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lotus Shell",
  "version": "0.1.0",
  "identifier": "com.lotusos.shell",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lotus Shell - LotusOS Preview",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ]
  }
}
