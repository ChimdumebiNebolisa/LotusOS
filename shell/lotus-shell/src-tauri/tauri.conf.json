{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lotus Shell",
  "version": "0.2.0",
  "identifier": "com.lotusos.shell",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lotus Shell - LotusOS",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ]
  }
}
